    <decisions>
        <name>Validar_Fecha_actual</name>
        <label>Validar Fecha actual</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>La_fecha_esta_dentro_del_rango</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>validarRango3Meses</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Cartera_Activa</targetReference>
            </connector>
            <label>La fecha esta dentro del rango?</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>validarRango3Meses</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    NOT( ISBLANK({!$Record.Fecha_de_Documento__c} ) ),
   {!$Record.Fecha_de_Documento__c} &gt;= DATE(
        YEAR(TODAY()),
        MONTH(TODAY()) - 3,
        DAY(TODAY())
    )
)</expression>
    </formulas>
    <interviewLabel>Update Domicilio - Estado Domicilio {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Domicilio - Estado Domicilio</label>
