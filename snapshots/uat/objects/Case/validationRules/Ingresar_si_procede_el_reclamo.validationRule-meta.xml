<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Ingresar_si_procede_el_reclamo</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(PRIORVALUE(Status), &quot;Análisis&quot;),
    NOT(ISPICKVAL(Status, &quot;Análisis&quot;)),
    ISBLANK(TEXT(Procede_el_Reclamo__c)),
    NOT(ISPICKVAL(Cumple_los_plazos__c, &quot;NO&quot;))
)</errorConditionFormula>
    <errorDisplayField>Procede_el_Reclamo__c</errorDisplayField>
    <errorMessage>Ingrese si procede el reclamo antes de avanzar.</errorMessage>
</ValidationRule>
