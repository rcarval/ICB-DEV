<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Motivo_Requerido_Estado_NoLista</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Estado_Nota_de_Credito__c , &quot;No lista&quot;),
    ISBLANK(Motivo__c)
)</errorConditionFormula>
    <errorDisplayField>Motivo__c</errorDisplayField>
    <errorMessage>Debe ingresar el Motivo cuando el Estado de Nota de Crédito es &quot;No lista&quot;.</errorMessage>
</ValidationRule>
