<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VAL_NC_no_existente</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISCHANGED(Status),
    ISPICKVAL(Status, &quot;Closed&quot;),
    NOT(Archivo_cargado__c)
)</errorConditionFormula>
    <errorMessage>Debe cargar la Nota de crédito correspondiente antes de cerrar el Caso.</errorMessage>
</ValidationRule>
