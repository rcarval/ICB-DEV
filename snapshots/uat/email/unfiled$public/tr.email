<!doctype html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Tu QR de Check-in</title>
</head>

<body style="margin:0; padding:0; background:#f3f4f6; font-family: Arial, sans-serif; color:#111827;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f4f6; padding:24px 0;">
    <tr>
      <td align="center">
        <!-- Card -->
        <table role="presentation" width="600" cellpadding="0" cellspacing="0"
               style="width:600px; max-width:600px; background:#ffffff; border:1px solid #e5e7eb; border-radius:12px;">
          <tr>
            <td style="padding:18px 22px; border-bottom:1px solid #e5e7eb;">
              <div style="font-size:18px; font-weight:700; line-height:1.2;">Check-in</div>
              <div style="font-size:12px; color:#6b7280; margin-top:4px;">ICB Food Service</div>
            </td>
          </tr>

          <tr>
            <td style="padding:22px;">
              <div style="font-size:14px; line-height:1.6;">
                Hola,<br/>
                Aquí tienes tu <b>QR de check-in</b>. Muéstralo al llegar.
              </div>

              <!-- QR -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:18px;">
                <tr>
                  <td align="center" style="padding:14px; background:#f9fafb; border:1px solid #e5e7eb; border-radius:12px;">
                    <img
  src="https://api.qrserver.com/v1/create-qr-code/?size=320x320&data=https://energy-saas-7178--uat.sandbox.my.site.com/qricbfs/?token={!CampaignMember.QR_Token__c}"
  alt="QR Check-in"
  width="320"
  height="320"
  style="display:block; border:0; border-radius:10px;"
/>

                  </td>
                </tr>
              </table>

              <!-- Button -->
              <table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:18px;">
                <tr>
                  <td align="center" style="background:#111827; border-radius:10px;">
                    <a
                      href="https://energy-saas-7178--uat.sandbox.my.site.com/qricbfs/?token={!CampaignMember.QR_Token__c}"
                      style="display:inline-block; padding:12px 18px; color:#ffffff; text-decoration:none; font-weight:700; font-size:14px;"
                    >
                      Abrir mi QR / Check-in
                    </a>
                  </td>
                </tr>
              </table>

              <!-- Fallback -->
              <div style="margin-top:14px; font-size:12px; color:#6b7280; line-height:1.6;">
                Si tu correo bloquea imágenes, usa el botón de arriba o copia y pega este link:<br/>
                <span style="word-break:break-all;">
                  https://energy-saas-7178--uat.sandbox.my.site.com/qricbfs/?token={!CampaignMember.QR_Token__c}
                </span>
              </div>

              <div style="margin-top:18px; border-top:1px solid #e5e7eb; padding-top:14px; font-size:12px; color:#6b7280;">
                Este QR es personal. Si lo reenvías, cualquiera con el link podría usarlo.
              </div>
            </td>
          </tr>
        </table>
        <!-- /Card -->

        <div style="font-size:11px; color:#9ca3af; margin-top:12px;">
          Mensaje automático • ICB Food Service
        </div>
      </td>
    </tr>
  </table>
</body>
</html>