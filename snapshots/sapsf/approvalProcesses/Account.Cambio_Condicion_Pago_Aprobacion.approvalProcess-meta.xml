<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>allInternalUsers</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>condicion_pago__c</field>
        <field>Condicion_Pago_Solicitada__c</field>
        <field>Estado_Aprobacion_Condicion_Pago__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <label>Aprobacion Gestor</label>
        <name>Aprobacion_Gestor</name>
    </approvalStep>
    <description>Proceso para aprobar cambios en condicion de pago ZD01 y ZE01.</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>AND(
OR(
ISPICKVAL(Condicion_Pago_Solicitada__c, &quot;ZD01&quot;),
ISPICKVAL(Condicion_Pago_Solicitada__c, &quot;ZE01&quot;)
),
ISPICKVAL(Estado_Aprobacion_Condicion_Pago__c, &quot;En Proceso de Aprobacion&quot;)
)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>CP_Aplicar_Condicion_Pago_Solicitada</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>CP_Clear_Condicion_Pago_Solicitada</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>CP_Set_Estado_Aprobada</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>CP_Clear_Condicion_Pago_Solicitada</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>CP_Set_Estado_Aprobada</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>Cambio Condicion Pago Aprobacion</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>true</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
