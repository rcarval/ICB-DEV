<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>validar_fecha_de_retiro</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISCHANGED(Fecha_retiro__c),
    Fecha_retiro__c &lt; TODAY()
)</errorConditionFormula>
    <errorDisplayField>Fecha_retiro__c</errorDisplayField>
    <errorMessage>La fecha de retiro no puede ser menor o igual a la fecha actual.</errorMessage>
</ValidationRule>
