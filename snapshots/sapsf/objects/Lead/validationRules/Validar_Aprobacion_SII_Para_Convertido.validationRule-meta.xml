<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validar_Aprobacion_SII_Para_Convertido</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status, &quot;Prospecto&quot;),
    NOT(Aprobado_SII__c)
)</errorConditionFormula>
    <errorMessage>Para convertir el Lead, primero debes aprobar la validación SII.</errorMessage>
</ValidationRule>
