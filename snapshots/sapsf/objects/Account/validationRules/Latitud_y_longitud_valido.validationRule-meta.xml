<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Latitud_y_longitud_valido</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 NOT(ISBLANK(ICBFS_Latitud_Longitud__c)),
 NOT(
  REGEX(
   ICBFS_Latitud_Longitud__c,
   &quot;^-?([0-8]?\\d(\\.\\d+)?|90(\\.0+)?)\\s*,\\s*-?(1[0-7]\\d(\\.\\d+)?|\\d?\\d(\\.\\d+)?|180(\\.0+)?)$&quot;
  )
 )
)</errorConditionFormula>
    <errorDisplayField>ICBFS_Latitud_Longitud__c</errorDisplayField>
    <errorMessage>El formato debe ser latitud, longitud. Ejemplo válido: -33.426180, -70.621251.</errorMessage>
</ValidationRule>
