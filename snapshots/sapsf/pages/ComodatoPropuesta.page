<?xml version="1.0" encoding="UTF-8"?>
<apex:page controller="ComodatoPropuestaController"
           renderAs="pdf"
           applyBodyTag="false"
           showHeader="false"
           standardStylesheets="false"
           docType="HTML-5.0">
    <head>
        <style type="text/css">
            @page {
                size: A4;
                margin: 20mm;
            }
            body {
                font-family: Arial, sans-serif;
                font-size: 10pt;
                color: #333333;
                margin: 0;
            }
            .header-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 20px;
            }
            .header-table td {
                padding: 0;
                vertical-align: middle;
            }
            .logo-left {
                text-align: left;
            }
            .logo-right {
                text-align: right;
            }
            .logo-left img {
                height: 70px;
            }
            .logo-right img {
                height: 70px;
                vertical-align: middle;
            }
            /* Marcas representadas, a continuacion de Lavazza en la misma linea.
               Los archivos vienen recortados a su contenido, asi que la altura es la del logo
               real. No van todas iguales: un emblema macizo --el ovalo de Kraft, el escudo de
               Don Juan-- pesa mas que una palabra a igual altura, y el wordmark de Kraft Heinz
               es el mas horizontal, asi que necesita algo menos para no comerse la linea. */
            .logo-right img.marca {
                margin-left: 16px;
            }
            .logo-right img.marca-kraft      { height: 20px; }
            .logo-right img.marca-kraftheinz { height: 18px; }
            .logo-right img.marca-nutella    { height: 20px; }
            .logo-right img.marca-donjuan    { height: 31px; }
            .propuesta-banner {
                background-color: #0000A0;
                color: white;
                text-align: center;
                padding: 8px 0;
                font-size: 14pt;
                font-weight: bold;
                letter-spacing: 3px;
                margin-bottom: 20px;
            }
            .machine-block {
                page-break-inside: avoid;
                margin-bottom: 20px;
            }
            .machine-image-container {
                text-align: center;
                width: 100%;
            }
            .machine-image-container img {
                max-width: 300px;
                height: auto;
                display: block;
                margin-left: auto;
                margin-right: auto;
            }
            .machine-image-container p {
                margin: 0;
                text-align: center;
            }
            .product-name {
                text-align: center;
                font-size: 12pt;
                font-weight: bold;
                letter-spacing: 1px;
                text-transform: uppercase;
                margin: 0 0 20px 0;
            }
            .table-block {
                page-break-inside: auto;
            }
            .main-table {
                width: 100%;
                border-collapse: collapse;
                border: 1px solid #0000A0;
                margin-bottom: 24px;
            }
            .main-table thead {
                display: table-header-group;
            }
            .main-table tbody {
                display: table-row-group;
            }
            .main-table tr,
            .main-table td,
            .main-table th {
                page-break-inside: avoid;
            }
            .main-table th {
                background-color: #0000A0;
                color: white;
                text-align: left;
                padding: 10px 14px;
                font-size: 9pt;
                text-transform: uppercase;
            }
            .main-table td {
                padding: 10px 14px;
                border-bottom: 1px solid #eeeeee;
                font-size: 9pt;
            }
            .aportes-section {
                page-break-inside: avoid;
            }
            .aportes-title {
                font-weight: bold;
                margin-bottom: 10px;
                font-size: 10pt;
            }
            .aportes-list {
                padding-left: 20px;
                list-style-type: disc;
            }
            .aportes-list li {
                margin-bottom: 6px;
                font-size: 9pt;
                font-weight: bold;
            }
            .technical-sheet {
                margin-top: 24px;
                page-break-inside: avoid;
            }
            .technical-sheet-title {
                font-weight: bold;
                margin-bottom: 10px;
                font-size: 10pt;
            }
            .technical-sheet-content {
                font-size: 9pt;
                line-height: 1.5;
            }
            .disclaimer {
                margin-top: 60px;
                font-size: 8pt;
                text-align: center;
                color: #666666;
            }
        </style>
    </head>
    <body>
        <table class="header-table">
            <tr>
                <td class="logo-left">
                    <img src="{!URLFOR($Resource.ICBLogo)}" alt="ICB Food Service"/>
                </td>
                <td class="logo-right">
                    <img src="{!URLFOR($Resource.LavazzaLogo)}" alt="Lavazza"/>
                    <img class="marca marca-kraft" src="{!URLFOR($Resource.LogoKraft)}" alt="Kraft"/>
                    <img class="marca marca-kraftheinz" src="{!URLFOR($Resource.LogoKraftHeinz)}" alt="Kraft Heinz"/>
                    <img class="marca marca-nutella" src="{!URLFOR($Resource.LogoNutella)}" alt="Nutella"/>
                    <img class="marca marca-donjuan" src="{!URLFOR($Resource.LogoDonJuan)}" alt="Don Juan"/>
                </td>
            </tr>
        </table>

        <div class="propuesta-banner">PROPUESTA</div>

        <div class="machine-block">
            <apex:outputPanel rendered="{!NOT(ISBLANK(machine.Imagen_Propuesta__c))}">
                <table width="100%" cellpadding="0" cellspacing="0" style="margin: 20px 0 30px 0;">
                    <tr>
                        <td align="center" style="text-align: center; padding: 0;">
                            <center>
                                <div class="machine-image-container">
                                    <apex:outputField value="{!machine.Imagen_Propuesta__c}"/>
                                </div>
                            </center>
                        </td>
                    </tr>
                </table>
            </apex:outputPanel>

            <div class="product-name">
                <apex:outputText value="{!machine.Name}"/>
            </div>
        </div>

        <div class="table-block">
            <table class="main-table">
                <thead>
                    <tr>
                        <th width="40%">DESCRIPCION</th>
                        <th width="30%">PRECIO UN NETO (KG)</th>
                        <th width="30%">CANTIDAD MINIMA MENSUAL</th>
                    </tr>
                </thead>
                <tbody>
                    <apex:repeat value="{!serviceLines}" var="s">
                        <tr>
                            <td><apex:outputText value="{!s.ServiceName}"/></td>
                            <td><apex:outputText value="{!s.FormattedPrice}"/></td>
                            <td><apex:outputText value="{!s.FormattedQty}"/></td>
                        </tr>
                    </apex:repeat>
                </tbody>
            </table>
        </div>

        <apex:outputPanel rendered="{!NOT(ISBLANK(aportesMarca))}" layout="block" styleClass="aportes-section">
            <p class="aportes-title">Aporte por Marca Lavazza, que contempla los siguientes elementos para potenciar la experiencia de cafe en su negocio:</p>
            <ul class="aportes-list">
                <apex:repeat value="{!aporteLines}" var="aporte">
                    <li><apex:outputText value="{!aporte}"/></li>
                </apex:repeat>
            </ul>
        </apex:outputPanel>

        <apex:outputPanel rendered="{!hasFichaTecnica}" layout="block" styleClass="technical-sheet">
            <p class="technical-sheet-title">FICHA TECNICA</p>
            <div class="technical-sheet-content">
                <apex:outputText value="{!fichaTecnicaHtml}" escape="false"/>
            </div>
        </apex:outputPanel>

        <div class="disclaimer">
            &quot;La entrega del equipo en comodato esta sujeta a la aprobacion de una linea de credito con la empresa.<br/>
            El contrato de comodato tendra una vigencia de 3 anos.&quot;
        </div>
    </body>
</apex:page>