<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Descarga de recuperación de PDF</masterLabel>
    <description>Descarga localmente el PDF mantenido en memoria cuando falla la firma digital.</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="contentVersionId" type="String" label="Compatibilidad histórica (no usado)" role="inputOnly" />
            <property name="pdfBase64" type="String" label="PDF en base64" role="inputOnly" />
            <property name="pdfFileName" type="String" label="Nombre del PDF" role="inputOnly" />
            <property name="opportunityId" type="String" label="Id de oportunidad" role="inputOnly" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>