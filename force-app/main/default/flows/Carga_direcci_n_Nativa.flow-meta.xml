<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>ASG_Set_Direccion_Nativa</name>
        <label>ASG Set Direccion Nativa</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.ShippingStreet</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmShippingStreet</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.ShippingCity</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmShippingCity</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.ShippingState</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmShippingState</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.BillingCity</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmBillingCity</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.BillingState</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmBillingState</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.ShippingCountry</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Chile</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>DEC_Hay_Datos_Direccion</name>
        <label>DEC Hay Datos Direccion</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Sin cambios de direccion</defaultConnectorLabel>
        <rules>
            <name>HayDatosDireccion</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CBFD_Calle__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ICBFS_Numero__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ICBFS_Referencia__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ICBFS_Comuna__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ICBFS_Region__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Comuna_Facturacion__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Regi_n_Facturacion__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ASG_Set_Direccion_Nativa</targetReference>
            </connector>
            <label>Hay datos direccion</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>frmBillingCity</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK(TEXT({!$Record.Comuna_Facturacion__c})),
  {!$Record.BillingCity},
    TEXT({!$Record.Comuna_Facturacion__c})
)</expression>
    </formulas>
    <formulas>
        <name>frmBillingState</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK(TEXT({!$Record.Regi_n_Facturacion__c})),
  {!$Record.BillingState},
    IF(
      CONTAINS(TEXT({!$Record.Regi_n_Facturacion__c}), &quot; - &quot;),
      TRIM(
        MID(
          TEXT({!$Record.Regi_n_Facturacion__c}),
          FIND(&quot; - &quot;, TEXT({!$Record.Regi_n_Facturacion__c})) + 3,
          LEN(TEXT({!$Record.Regi_n_Facturacion__c}))
        )
      ),
      TEXT({!$Record.Regi_n_Facturacion__c})
    )
)</expression>
    </formulas>
    <formulas>
        <name>frmShippingCity</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK(TEXT({!$Record.ICBFS_Comuna__c})),
  {!$Record.ShippingCity},
    TEXT({!$Record.ICBFS_Comuna__c})
)</expression>
    </formulas>
    <formulas>
        <name>frmShippingState</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK(TEXT({!$Record.ICBFS_Region__c})),
  {!$Record.ShippingState},
    IF(
      CONTAINS(TEXT({!$Record.ICBFS_Region__c}), &quot; - &quot;),
      TRIM(
        MID(
          TEXT({!$Record.ICBFS_Region__c}),
          FIND(&quot; - &quot;, TEXT({!$Record.ICBFS_Region__c})) + 3,
          LEN(TEXT({!$Record.ICBFS_Region__c}))
        )
      ),
      TEXT({!$Record.ICBFS_Region__c})
    )
)</expression>
    </formulas>
    <formulas>
        <name>frmShippingStreet</name>
        <dataType>String</dataType>
        <expression>IF(
  AND(
    ISBLANK({!$Record.CBFD_Calle__c}),
    ISBLANK({!$Record.ICBFS_Numero__c})
  ),
  {!$Record.ShippingStreet},
  TRIM(
    IF(ISBLANK({!$Record.CBFD_Calle__c}), &quot;&quot;, {!$Record.CBFD_Calle__c}) &amp;
    IF(ISBLANK({!$Record.ICBFS_Numero__c}), &quot;&quot;, &quot; &quot; &amp; {!$Record.ICBFS_Numero__c})
  )
)</expression>
    </formulas>
    <interviewLabel>Carga dirección Nativa {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Carga dirección Nativa</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>DEC_Hay_Datos_Direccion</targetReference>
        </connector>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
