<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <!-- Entradas del Flow -->
            <property
                name="allowDynamicFilters"
                type="Boolean"
                label="Mostrar Filtros Dinámicos (solo admins)"
                role="inputOnly"
            />
            <property
                name="initialBusinessFilter"
                type="String"
                label="Filtro Inicial de Negocio"
                role="inputOnly"
            />
            <property
                name="pricebookId"
                type="String"
                label="ID de Lista de Precios"
                role="inputOnly"
            />
            <property
                name="preSelectedMachineId"
                type="String"
                label="ID Máquina Pre-seleccionada (restaurar al volver)"
                role="inputOnly"
            />
            <!-- Salidas al Flow -->
            <property
                name="selectedMachineId"
                type="String"
                label="ID de la Máquina Seleccionada"
                role="outputOnly"
            />
            <property
                name="selectedMachineName"
                type="String"
                label="Nombre de la Máquina Seleccionada"
                role="outputOnly"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>