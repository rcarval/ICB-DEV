<apex:page controller="EnviarSAPGateController"
           action="{!init}"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false"
           applyHtmlTag="false"
           applyBodyTag="false"
           docType="html-5.0">
<html lang="es">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Enviar a SAP</title>
    <style>
        :root {
            color-scheme: light;
            --brand: #a11f3f;
            --ink: #233041;
            --muted: #667489;
            --line: #d8dee8;
            --bg: #f6f8fb;
            --card: #ffffff;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: var(--ink);
            background:
                radial-gradient(circle at top right, rgba(161, 31, 63, 0.12), transparent 28%),
                linear-gradient(180deg, #fbfcfe 0%, var(--bg) 100%);
            min-height: 100vh;
        }

        .wrap {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 20px;
        }

        .card {
            width: min(760px, 100%);
            background: var(--card);
            border: 1px solid rgba(161, 31, 63, 0.12);
            border-radius: 24px;
            box-shadow: 0 18px 40px rgba(35, 48, 65, 0.12);
            overflow: hidden;
        }

        .header {
            padding: 28px 32px 18px;
            border-bottom: 1px solid var(--line);
            background: linear-gradient(135deg, rgba(161, 31, 63, 0.06), rgba(255, 255, 255, 0));
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--brand);
            background: rgba(161, 31, 63, 0.08);
        }

        h1 {
            margin: 14px 0 0;
            font-size: 32px;
            line-height: 1.1;
        }

        .content {
            padding: 28px 32px 34px;
        }

        .lead {
            margin: 0 0 14px;
            font-size: 18px;
            line-height: 1.5;
        }

        p {
            margin: 0 0 14px;
            line-height: 1.6;
        }

        .issue-list {
            margin: 18px 0 0;
            padding: 0;
            list-style: none;
            display: grid;
            gap: 10px;
        }

        .issue-list li {
            padding: 12px 14px;
            border: 1px solid var(--line);
            border-radius: 14px;
            background: #fbfcff;
        }

        .hint {
            margin-top: 22px;
            color: var(--muted);
        }
    </style>
</head>
<body>
    <div class="wrap">
        <div class="card">
            <div class="header">
                <div class="eyebrow">Enviar a SAP</div>
                <h1>Validacion previa del envio</h1>
            </div>
            <div class="content">
                <apex:outputPanel rendered="{!hasError}">
                    <p class="lead">No fue posible continuar con la validacion.</p>
                    <p>{!errorMessage}</p>
                </apex:outputPanel>

                <apex:outputPanel rendered="{!hasMissingFields}">
                    <p class="lead">
                        La cuenta <strong><apex:outputText value="{!accountName}"/></strong>
                        no cumple las precondiciones para enviar a SAP.
                    </p>
                    <p>Completa estos datos antes de reintentar:</p>
                    <ul class="issue-list">
                        <apex:repeat value="{!missingFields}" var="item">
                            <li><apex:outputText value="{!item}"/></li>
                        </apex:repeat>
                    </ul>
                    <p class="hint">Cuando la cuenta quede completa, vuelve a presionar <strong>Enviar a SAP</strong>.</p>
                </apex:outputPanel>

                <apex:outputPanel rendered="{!AND(NOT(hasError), NOT(hasMissingFields))}">
                    <p class="lead">La cuenta esta lista. Seras redirigido automaticamente al flujo de envio.</p>
                </apex:outputPanel>
            </div>
        </div>
    </div>
</body>
</html>
</apex:page>