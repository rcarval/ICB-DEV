<apex:page controller="seidor_PDFController" sidebar="false" showHeader="false" standardStylesheets="false" renderAs="{!IF(isPreview, '', 'pdf')}">

<div style="width:80%; margin:0 auto;">

    <!-- ================= ENCABEZADO ================= -->
    <table style="width:100%; border:2px solid #000; padding:6px; margin-bottom:6px; border-collapse:collapse;">
        <tr>
            <!-- LOGO IZQUIERDA -->
            <td style="width:18%; vertical-align:middle; text-align:left;">
                <apex:image url="https://energy-saas-7178--qa2--c.sandbox.vf.force.com/resource/1757015875000/imagenICB?" width="90" />
            </td>

            <!-- CENTRO + DERECHA -->
            <td style="width:82%;">

                <table style="width:100%; border-collapse:collapse;">
                    <tr>
                        <!-- TITULOS -->
                        <td style="text-align:left;">
                            <div style="font-size:16px; font-family:Arial, sans-serif; font-weight:bold; background:#C0C0C0;">
                                Formulario de Devolución y Retiro
                            </div>
                            <div style="font-size:13px; font-family:Arial, sans-serif; margin-top:1px; font-weight:bold;">
                                {!tipoRequerimiento}
                            </div>
                        </td>

                        <!-- SOLICITUD N° (DERECHA) -->
                        <td style="width:25%; text-align:right; vertical-align:top; font-size:10px; font-family:Arial, sans-serif;">
                            <table style="border-collapse:collapse; width:100%;">
                                <tr>
                                    <td style="border:1px solid #000; padding:3px 5px;">
                                        <b>Solicitud N°</b>
                                    </td>
                                    <td style="border:1px solid #000; padding:3px 5px;">
                                        {!caso.CaseNumber}
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>

            </td>
        </tr>
    </table>

    <!-- ================= CABECERA DE CASO ================= -->
    <div style="border:1px solid #000; margin-bottom:6px; font-family:Arial, sans-serif; font-size:10px;">
        <div style="background:#C0C0C0; font-weight:bold; padding:4px 6px; border-bottom:1px solid #000;">
            Datos del caso
        </div>
        <table style="width:100%; border-collapse:collapse;">
            <tr>
                <td style="padding:3px 5px; width:25%;"><b>Área</b></td>
                <td style="border-bottom:1px solid #000; padding:3px 5px; width:25%;">{!caso.Area__c}</td>
                <td style="padding:3px 5px; width:25%;"><b>Categoría</b></td>
                <td style="border-bottom:1px solid #000; padding:3px 5px; width:25%;">{!caso.Categoria__c}</td>
            </tr>
            <tr>
                <td style="padding:3px 5px;"><b>Sub-categoría</b></td>
                <td style="border-bottom:1px solid #000; padding:3px 5px;">{!caso.Sub_Categoria__c}</td>
                <td style="padding:3px 5px;"><b>Motivo de la devolución</b></td>
                <td style="border-bottom:1px solid #000; padding:3px 5px;">{!caso.Motivo__c}</td>
            </tr>
        </table>
    </div>

    <!-- ================= TABLA PRODUCTOS ================= -->
    <table style="width:100%; border-collapse:collapse; font-size:10px; font-family:Arial, sans-serif;">
        <tr>
            <th style="background:#C0C0C0; border:1px solid #000; padding:4px;">N°</th>
            <th style="background:#C0C0C0; border:1px solid #000; padding:4px;">Código SAP</th>
            <th style="background:#C0C0C0; border:1px solid #000; padding:4px;">Material</th>
            <th style="background:#C0C0C0; border:1px solid #000; padding:4px;">Cantidad | Unidad de medida</th>
            <th style="background:#C0C0C0; border:1px solid #000; padding:4px;">Valor Neto</th>
        </tr>
        <apex:repeat value="{!detallesWrapper}" var="dw">
            <tr>
                <td style="border:1px solid #000; padding:4px; text-align:center;">
                    {!dw.rowNum}
                </td>
                <td style="border:1px solid #000; padding:4px; text-align:center;">
                    {!dw.det.SKU__c}
                </td>
                <td style="border:1px solid #000; padding:4px;">
                    <b>{!dw.det.Product__r.Name}</b>
                </td>
                <td style="border:1px solid #000; padding:4px; text-align:center;">
                    {!dw.det.Cantidad__c} | {!dw.det.Unidad_de_Medida__c}
                </td>
                <td style="border:1px solid #000; padding:4px;">
                    $
                    <apex:outputText value="{0,number,#,##0}">
                        <apex:param value="{!dw.det.Valor_Neto__c}" />
                    </apex:outputText>
                </td>
            </tr>
        </apex:repeat>
        <tr>
            <td colspan="4" style="border:1px solid #000; padding:4px; text-align:right; font-weight:bold; background:#C0C0C0;">
                Total:
            </td>
            <td style="border:1px solid #000; padding:4px; font-weight:bold; background:#C0C0C0;">
                $
                <apex:outputText value="{0,number,#,##0}">
                    <apex:param value="{!totalValorNeto}" />
                </apex:outputText>
            </td>
        </tr>
    </table>

    <!-- ================= CLIENTE | PEDIDO ================= -->
    <table style="width:100%; border-collapse:collapse; margin-top:6px; margin-bottom:4px;">
        <tr>
            <!-- ================= DATOS CLIENTE (IZQUIERDA) ================= -->
            <td style="width:50%; vertical-align:top; padding-right:6px;">

                <div style="border:1px solid #000;">
                    <div style="background:#C0C0C0; font-weight:bold; padding:4px 6px; border-bottom:1px solid #000; font-family:Arial, sans-serif; font-size:10px;">
                        Datos del cliente:
                    </div>
                    <div style="padding:4px;">
                        <table style="width:100%; border-collapse:collapse; font-size:10px; font-family:Arial, sans-serif;">
                            <tr>
                                <td style="padding:3px 4px;">
                                    <b>Razón social</b>
                                </td>
                                <td style="border-bottom:1px solid #000; padding:3px 4px;" colspan="3">
                                    {!caso.Account.Name}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:3px 4px;">
                                    <b>Nombre fantasia</b>
                                </td>
                                <td style="border-bottom:1px solid #000; padding:3px 4px;" colspan="3">
                                    {!caso.Account.Nombre_de_Fantasia__c}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:3px 4px;">
                                    <b>RUT</b>
                                </td>
                                <td style="border-bottom:1px solid #000; padding:3px 4px;" colspan="3">
                                    {!caso.Account.RUT__c}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:3px 4px;">
                                    <b>Cód. cliente despacho</b>
                                </td>
                                <td style="border-bottom:1px solid #000; padding:3px 4px;" colspan="3">
                                    {!caso.Cliente_Despacho__c}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:3px 4px;">
                                    <b>Dirección retiro</b>
                                </td>
                                <td style="border-bottom:1px solid #000; padding:3px 4px;" colspan="2">
                                    {!caso.Nombre_Direcci_n__c}
                                </td>
                                <td style="border-bottom:1px solid #000; padding:3px 4px;" colspan="1">
                                    | {!caso.Sucursal_de_Retiro__r.Comuna_Despacho__r.Name}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:3px 4px;">
                                    <b>Contacto</b>
                                </td>
                                <td style="border-bottom:1px solid #000; padding:3px 4px;" colspan="3">
                                    {!caso.Contact.Name}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:3px 4px;">
                                    <b>Fono</b>
                                </td>
                                <td style="border-bottom:1px solid #000; padding:3px 4px;">
                                    {!caso.ContactMobile}
                                </td>
                                <td style="padding:3px 4px;">
                                    <b>Región</b>
                                </td>
                                <td style="border-bottom:1px solid #000; padding:3px 4px;">
                                    {!caso.Sucursal_de_Retiro__r.Region_Despacho__c}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:3px 4px;">
                                    <b>Procesado por</b>
                                </td>
                                <td style="border-bottom:1px solid #000; padding:3px 4px;" colspan="3">
                                    {!caso.Owner.Name}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:3px 4px;">
                                    <b>Horario retiro</b>
                                </td>
                                <td style="border-bottom:1px solid #000; padding:3px 4px;" colspan="3">
                                    {!caso.Horario_retiro__c}
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

            </td>

            <!-- ================= DATOS PEDIDO (DERECHA) ================= -->
            <td style="width:50%; vertical-align:top; padding-left:6px;">

                <div style="border:1px solid #000;">
                    <div style="background:#C0C0C0; font-weight:bold; padding:4px 6px; border-bottom:1px solid #000; font-family:Arial, sans-serif; font-size:10px;">
                        Datos del Pedido
                    </div>
                    <div style="padding:4px;">
                        <table style="width:100%; border-collapse:collapse; font-size:10px; font-family:Arial, sans-serif;">
                            <tr>
                                <td style="padding:3px 4px;">
                                    <b>Fecha solicitud</b>
                                </td>
                                <td style="border-bottom:1px solid #000; padding:3px 4px;" colspan="3">
                                    <apex:outputText value="{0,date,dd-MM-yyyy}">
                                        <apex:param value="{!caso.CreatedDate}" />
                                    </apex:outputText>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:3px 4px;">
                                    <b>Factura N°</b>
                                </td>
                                <td style="border-bottom:1px solid #000; padding:3px 4px;" colspan="3">
                                    {!caso.N_Factura__c}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:3px 4px;">
                                    <b>Fecha factura</b>
                                </td>
                                <td style="border-bottom:1px solid #000; padding:3px 4px;" colspan="3">
                                    <apex:outputText value="{0,date,dd-MM-yyyy}">
                                        <apex:param value="{!caso.Fecha_Factura__c}" />
                                    </apex:outputText>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:3px 4px;">
                                    <b>Asesor</b>
                                </td>
                                <td style="border-bottom:1px solid #000; padding:3px 4px;" colspan="3">
                                    {!caso.Account.Owner.Name}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:3px 4px;">
                                    <b>Jefe de canal</b>
                                </td>
                                <td style="border-bottom:1px solid #000; padding:3px 4px;" colspan="3">
                                    {!supervisorName}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:3px 4px;">
                                    <b>Usuario digitación</b>
                                </td>
                                <td style="border-bottom:1px solid #000; padding:3px 4px;" colspan="3">
                                    {!caso.Owner.Name}
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- ===== DIAS LOCAL CERRADO ===== -->
                    <div style="border:1px solid #000; margin:4px 6px 6px 6px;">
                        <div style="background:#C0C0C0; font-weight:bold; padding:3px 5px; border-bottom:1px solid #000; font-family:Arial, sans-serif; text-align:center; font-size:9px;">
                            Días local cerrado
                        </div>
                        <div style="padding:4px;">
                            <table style="width:100%; border-collapse:collapse; font-size:9px; font-family:Arial, sans-serif;">
                                <tr>
                                    <td style="padding:2px; width:16px; text-align:center;">
                                        <table style="border-collapse:collapse; margin:0 auto;">
                                            <tr>
                                                <td style="width:10px; height:10px; border:1px solid #000; {!IF(isLunesCerrado, 'background:#000;', 'background:#FFF;')}"></td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td style="padding:2px;">Lunes</td>
                                    <td style="padding:2px; width:16px; text-align:center;">
                                        <table style="border-collapse:collapse; margin:0 auto;">
                                            <tr>
                                                <td style="width:10px; height:10px; border:1px solid #000; {!IF(isJuevesCerrado, 'background:#000;', 'background:#FFF;')}"></td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td style="padding:2px;">Jueves</td>
                                </tr>
                                <tr>
                                    <td style="padding:2px; text-align:center;">
                                        <table style="border-collapse:collapse; margin:0 auto;">
                                            <tr>
                                                <td style="width:10px; height:10px; border:1px solid #000; {!IF(isMartesCerrado, 'background:#000;', 'background:#FFF;')}"></td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td style="padding:2px;">Martes</td>
                                    <td style="padding:2px; text-align:center;">
                                        <table style="border-collapse:collapse; margin:0 auto;">
                                            <tr>
                                                <td style="width:10px; height:10px; border:1px solid #000; {!IF(isViernesCerrado, 'background:#000;', 'background:#FFF;')}"></td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td style="padding:2px;">Viernes</td>
                                </tr>
                                <tr>
                                    <td style="padding:2px; text-align:center;">
                                        <table style="border-collapse:collapse; margin:0 auto;">
                                            <tr>
                                                <td style="width:10px; height:10px; border:1px solid #000; {!IF(isMiercolesCerrado, 'background:#000;', 'background:#FFF;')}"></td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td style="padding:2px;">Miércoles</td>
                                    <td style="padding:2px; text-align:center;">
                                        <table style="border-collapse:collapse; margin:0 auto;">
                                            <tr>
                                                <td style="width:10px; height:10px; border:1px solid #000; {!IF(isSabadoCerrado, 'background:#000;', 'background:#FFF;')}"></td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td style="padding:2px;">Sábado</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                </div>

            </td>
        </tr>
    </table>

    <!-- ================= DATOS DEL TRANSPORTE ================= -->
    <div style="margin-top:6px;">
        <div style="margin-left:6px;">
            <p style="font-size:9px; font-family:Arial, sans-serif; margin:1px 0;">*Información para ser completada por Logística*</p>
        </div>
        <div style="border:1px solid #000;">
            <div style="background:#C0C0C0; font-family:Arial, sans-serif; font-weight:bold; padding:4px 6px; font-size:10px;">
                Datos del transporte:
            </div>

            <div style="padding:4px;">
                <table style="width:100%; border-collapse:collapse; font-size:10px; font-family:Arial, sans-serif;">

                    <tr>
                        <!-- ================= IZQUIERDA: TRANSPORTE ================= -->
                        <td style="width:40%; vertical-align:top; padding-right:8px;">

                            <table style="width:100%; border-collapse:collapse;">
                                <tr>
                                    <td style="padding:3px 4px;">
                                        <b>Nombre del transporte</b>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border-bottom:1px solid #000; padding:3px 4px;">
                                        {!caso.Transporte__r.Name}
                                    </td>
                                </tr>
                                <tr rendered="{!isDevolucion}">
                                    <td style="padding:3px 4px;">
                                        <b>Nueva dirección retiro</b>
                                    </td>
                                </tr>
                                <tr rendered="{!isDevolucion}">
                                    <td style="border-bottom:1px solid #000; padding:3px 4px; {!IF(ISBLANK(caso.Direccion_de_retiro_new__c), '', 'background:#FFFF00;')}">
                                        {!IF(ISBLANK(caso.Direccion_de_retiro_new__c), 'No aplica', caso.Direccion_de_retiro_new__c)}
                                    </td>
                                </tr>
                            </table>

                        </td>

                        <!-- ================= CENTRO: FECHAS / NC ================= -->
                        <td style="width:30%; vertical-align:top; padding-left:8px;">

                            <table style="width:100%; border-collapse:collapse;">
                                <tr>
                                    <td style="padding:3px 4px; width:40%;">
                                        <b>Fecha retiro</b>
                                    </td>
                                    <td style="border-bottom:1px solid #000; padding:3px 4px;">
                                        <apex:outputText value="{0,date,dd-MM-yyyy}">
                                            <apex:param value="{!caso.Fecha_retiro__c}" />
                                        </apex:outputText>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:3px 4px;">
                                        <b>Fecha rendición</b>
                                    </td>
                                    <td style="border-bottom:1px solid #000; padding:3px 4px;">
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:3px 4px;">
                                        <b>Nota de crédito</b>
                                    </td>
                                    <td style="border-bottom:1px solid #000; padding:3px 4px;">
                                    </td>
                                </tr>
                            </table>

                        </td>

                        <!-- ================= DERECHA: ESTADO MERCADERÍA SAC ================= -->
                        <td style="width:30%; vertical-align:top; padding-left:8px;">
                            <table style="width:100%; border-collapse:collapse; font-size:10px; font-family:Arial, sans-serif;">
                                <tr>
                                    <td colspan="2" style="border:1px solid #000; background:#C0C0C0; font-weight:bold; padding:3px 4px; text-align:center;">
                                        Estado de mercadería SAC
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border:1px solid #000; padding:3px 4px; width:80%; background:#FFFF00;">
                                        Producto en buen estado
                                    </td>
                                    <td style="border:1px solid #000; padding:3px 4px; width:20%;"></td>
                                </tr>
                                <tr>
                                    <td style="border:1px solid #000; padding:3px 4px; width:80%; background:#FFFF00;">
                                        Producto en malas condiciones
                                    </td>
                                    <td style="border:1px solid #000; padding:3px 4px; width:20%;"></td>
                                </tr>
                            </table>

                            <!-- ================= ESTADO MERCADERÍA ================= -->
                            <div style="font-weight:bold; padding:4px 0 2px 0; font-size:10px; font-family:Arial, sans-serif;">
                                Estado de la mercadería:
                            </div>
                            <table style="width:100%; border-collapse:collapse; font-size:10px; font-family:Arial, sans-serif;">
                                <tr>
                                    <td style="border:1px solid #000; padding:3px 4px; width:20%;">
                                        <b>Bueno</b>
                                    </td>
                                    <td style="border:1px solid #000; padding:3px 4px; width:80%;"></td>
                                </tr>
                                <tr>
                                    <td style="border:1px solid #000; padding:3px 4px;">
                                        <b>Malo</b>
                                    </td>
                                    <td style="border:1px solid #000; padding:3px 4px;"></td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <!-- ================= OBSERVACIONES ================= -->
    <div style="margin-top:6px;">
        <div style="background:#C0C0C0; font-family:Arial, sans-serif; font-weight:bold; padding:4px 6px; border-bottom:1px solid #000; height:10px; font-size:10px;">
            Observación
        </div>
    </div>

    <apex:outputPanel rendered="{!AND(isPreview, NOT(ISBLANK($CurrentPage.parameters.refresh)))}">
        <meta http-equiv="refresh" content="{!$CurrentPage.parameters.refresh}" />
    </apex:outputPanel>

</div>

</apex:page>